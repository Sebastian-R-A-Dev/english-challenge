# Copia a `.env.local` o `.env` y ajusta valores.

# ArcadeCore API (sin slash final). Refresh: POST {origin}/api/v1/auth/refresh
NEXT_PUBLIC_ARCADECORE_API_BASE_URL=http://localhost:4000

# generic-login (incluye /login). Si refresh falla o no hay cookie, redirige aquí con ?redirect-to=
NEXT_PUBLIC_LOGIN_URL=http://localhost:3000/login

# Identificador de app en ArcadeCore (`App.name`) y en generic-login (?redirect-to). Obligatorio para aislar refresh/session entre SPAs que comparten la misma cookie en el API.
NEXT_PUBLIC_APP_NAME=ENGLISH-CHALLENGE
